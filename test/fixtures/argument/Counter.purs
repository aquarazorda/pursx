type Props = { label :: String, count :: Int }

counter :: Component Props
counter = Component.component \props ->
  (H.div { class:"counter" }
    [ (H.p {} (props.label))
  , (H.span {} (show props.count))
  , (H.button
      { onClick:(\_ -> unit)
    , disabled:true
    , "aria-label":"Increment" }
     "+") ]
       )

list :: Array String -> JSX
list items =
  (H.ul { class:"list" }
    (map (\item -> (H.li {} (item))) items)
      )

-- Text, entities, whitespace and comments.
prose :: String -> JSX
prose name =
  (H.p {}
    [ JSX.text "Hello,  ", (H.span {} (name)), JSX.text "! Fish & chips <3" ]

     )

form :: JSX
form = (H.div {} [ (H.input { value:"x" }), (H.br {}) ])

-- Components, with and without children.
app :: JSX
app =
  (H.div {}
    [ (Component.element counter { label:"Clicks", count:(1 + 1) })
  , (Component.element panel { title:"Hi",
      children: (H.span {} "Inside") }
           ) ]
       )

panel :: Component { title :: String, children :: JSX }
panel = Component.component \props ->
  (H.div { title:(props.title) } (props.children))

-- A do block inside a hole keeps its layout.
nested :: Boolean -> JSX
nested flag =
  (H.div {}
    [ (if flag then (H.span {} "yes") else JSX.text "no")
  , (let
       total = Array.length [ 1, 2, 3 ]
     in
       JSX.text (show total)) ]
       )
