module Fixture.Prop.Profile where

import Prelude

import Stub.JSX (JSX)
import Stub.React as R

type User = { name :: String, admin :: Boolean }

profile :: User -> JSX
profile user =
  <div className="profile">
    <span>{R.text user.name}</span>
    {if user.admin then <span>Admin</span> else R.text ""}
    <input value={user.name} disabled />
    <Badge label="new" />
    <button onClick={\_ -> unit}>
      Edit &quot;{R.text user.name}&quot;
    </button>
  </div>

badge :: { label :: String } -> JSX
badge { label } = <span className="badge">{R.text label}</span>
