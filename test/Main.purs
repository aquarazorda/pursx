module Test.Main where

import Prelude

import Data.Argonaut.Parser (jsonParser)
import Data.Array as Array
import Data.Either (Either(..), either)
import Data.Maybe (Maybe(..))
import Data.Foldable (for_)
import Data.String as String
import Data.Traversable (for)
import Effect (Effect)
import Effect.Aff (Aff)
import Effect.Exception (throw)
import Node.Encoding (Encoding(..))
import Node.FS.Sync as FS
import Node.Path as Path
import PursX (Config, defaultConfig, fromJson, transform)
import Test.Spec (Spec, describe, it)
import Test.Spec.Assertions (fail, shouldEqual)
import Test.Spec.Reporter (consoleReporter)
import Test.Spec.Runner.Node (runSpecAndExitProcess)

type Fixture = { name :: String, config :: Config, source :: String, expected :: String }

main :: Effect Unit
main = do
  fixtures <- loadFixtures "test/fixtures"
  runSpecAndExitProcess [ consoleReporter ] do
    fixtureSpec fixtures
    lexingSpec
    desugarSpec
    errorSpec
    sizeSpec

-- | Each directory under `test/fixtures` has a `pursx.json` and `.purx`
-- | files with their generated `.purs`, which `spago test` also compiles
-- | against the stubs in `test/Stub`. Regenerate them with
-- | `node scripts/pursx-dev.mjs test/fixtures`.
loadFixtures :: String -> Effect (Array Fixture)
loadFixtures root = do
  dirs <- FS.readdir root
  Array.concat <$> for dirs \dir -> do
    let path = Path.concat [ root, dir ]
    configText <- FS.readTextFile UTF8 (Path.concat [ path, "pursx.json" ])
    config <- either throw pure (fromJson =<< jsonParser configText)
    files <- Array.filter (\f -> Path.extname f == ".purx") <$> FS.readdir path
    for files \file -> do
      source <- FS.readTextFile UTF8 (Path.concat [ path, file ])
      generated <- FS.readTextFile UTF8 (Path.concat [ path, Path.basenameWithoutExt file ".purx" <> ".purs" ])
      pure { name: dir <> "/" <> file, config, source, expected: withoutMarker generated }
  where
  withoutMarker s = case String.lastIndexOf (String.Pattern "-- Generated by pursx") s of
    Just i -> String.take i s
    Nothing -> s

fixtureSpec :: Array Fixture -> Spec Unit
fixtureSpec fixtures = describe "fixtures" do
  for_ fixtures \fixture -> it fixture.name do
    case transform fixture.config fixture.source of
      Left e -> fail (show e)
      Right code -> do
        code `shouldEqual` fixture.expected
        lineCount code `shouldEqual` lineCount fixture.source

lineCount :: String -> Int
lineCount s = Array.length (String.split (String.Pattern "\n") s)

converts :: String -> String -> Aff Unit
converts source expected = transform defaultConfig source `shouldEqual` Right expected

unchanged :: String -> Aff Unit
unchanged source = converts source source

lexingSpec :: Spec Unit
lexingSpec = describe "telling JSX from operators" do
  it "leaves comparisons alone" do
    unchanged "x = a < b"
    unchanged "x = a <b"
    unchanged "x = (_ < b)"
    unchanged "x = f <$> a <*> b <> c <<< d"
  it "skips strings, characters and comments" do
    unchanged "x = \"<div>\""
    unchanged "x = \"\"\"<div>\"\"\""
    unchanged "x = '<'"
    unchanged "x = y -- <div>"
    unchanged "x = y --> <div>"
    unchanged "x = y {- <div> {- <a> -} -}"
    unchanged "x = \"a\\\"<div>\""
  it "keeps primes in identifiers" do
    unchanged "x = f' a' <b"
  it "finds JSX where an expression starts" do
    converts "x = <a/>" "x = (a {} [])"
    converts "x = f $ <a/>" "x = f $ (a {} [])"
    converts "x = [<a/>, <b/>]" "x = [(a {} []), (b {} [])]"
    converts "x = if c then <a/> else <b/>" "x = if c then (a {} []) else (b {} [])"
    converts "x = y |-- <a/>" "x = y |-- (a {} [])"
    converts "x = do\n  y\n  <a/>" "x = do\n  y\n  (a {} [])"
  it "leaves an argument position alone" do
    unchanged "x = f <a/>"

desugarSpec :: Spec Unit
desugarSpec = describe "desugaring" do
  it "turns attributes into a record" do
    converts "x = <a b=\"1\" c={d} e />" "x = (a { b:\"1\", c:(d), e:true } [])"
  it "quotes labels that are not identifiers" do
    converts "x = <a aria-label=\"x\" on:click={f} />" "x = (a { \"aria-label\":\"x\", \"on:click\":(f) } [])"
  it "wraps text among other children" do
    converts "x = <a>hi {b}</a>" "x = (a {} [ text \"hi \", (b) ])"
  it "collapses whitespace across lines" do
    converts "x = <a>\n  one\n  two\n</a>" "x = (a {}\n  [ text \"one two\" ]\n\n   )"
  it "escapes text and decodes entities" do
    converts "x = <a>\"\\ &amp; &#65;&#x42;</a>" "x = (a {} [ text \"\\\"\\\\ & AB\" ])"
  it "calls void elements with props only" do
    converts "x = <input a={b} />" "x = (input { a:(b) })"
  it "calls components through the configured function" do
    transform defaultConfig { component = "C.make" } "x = <Foo.Bar a=\"1\"><b/></Foo.Bar>"
      `shouldEqual` Right "x = (C.make Foo.bar { a:\"1\", children: [ (b {} []) ] })"
  it "puts children in the record when configured" do
    transform defaultConfig { children = fromJsonStyle } "x = <a b=\"1\">hi</a>"
      `shouldEqual` Right "x = (a { b:\"1\", children: [ text \"hi\" ] })"
  it "keeps lines inside holes" do
    converts "x = <a>{do\n  y\n  z}</a>" "x = (a {} [ (do\n  y\n  z) ])"
  where
  fromJsonStyle = either (const defaultConfig.children) _.children (fromJson =<< jsonParser "{\"children\":\"prop\"}")

errorSpec :: Spec Unit
errorSpec = describe "errors" do
  it "unclosed element" do
    failsWith "x = <div>" 1 5 "`<div>` is never closed."
  it "mismatched closing tag" do
    failsWith "x = <div></span>" 1 10 "Expected `</div>`, found `</span>`."
  it "void element with children" do
    failsWith "x = <input>hi</input>" 1 5 "`<input>` is a void element and cannot have children."
  it "duplicate attribute" do
    failsWith "x = <a b=\"1\" b=\"2\" />" 1 14 "Attribute `b` is given twice."
  it "brace in text" do
    failsWith "x = <a>}</a>" 1 8 "Unexpected `}` in text. Write `{\"}\"}` for a literal `}`."
  it "angle bracket in text" do
    failsWith "x = <a>a < b</a>" 1 10 "Unexpected `<` in text. Write `{\"<\"}` for a literal `<`."
  it "spread attribute" do
    failsWith "x = <a {...p} />" 1 8 "Spread attributes are not supported."
  it "empty expression" do
    failsWith "x = <a b={} />" 1 10 "Attribute `b` has an empty expression."
  it "operator section without a space" do
    failsWith "x = (<a)" 1 8 "Unexpected character in `<a>`. If you meant the `<` operator, put a space after it."
  it "unclosed hole" do
    failsWith "x = <a>{b</a>" 1 8 "This `{` is never closed."
  where
  failsWith source line column message = case transform defaultConfig source of
    Left e -> { line: e.pos.line, column: e.pos.column, message: e.message } `shouldEqual` { line, column, message }
    Right code -> fail ("Expected an error, got: " <> code)

sizeSpec :: Spec Unit
sizeSpec = describe "large inputs" do
  it "many elements" do
    let source = String.joinWith "\n" (Array.replicate 10000 "x = <a b={c}>d <e /></a>")
    map lineCount (transform defaultConfig source) `shouldEqual` Right 10000
  it "many children" do
    let source = "x = <a>" <> String.joinWith "\n" (Array.replicate 10000 "<b>c</b>") <> "</a>"
    map lineCount (transform defaultConfig source) `shouldEqual` Right 10000
